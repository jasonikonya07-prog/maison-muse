# Optional absolute or relative path to the SQLite database.
# Relative paths are resolved from this backend directory.
DATABASE_PATH=data/maison_muse.sqlite3

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required for admin sign-in. Set unique values before starting the API.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_ROLE=Super Admin
# Generate a unique 32+ character signing secret for buyer/seller JWTs.
AUTH_JWT_SECRET=
# Required only for buyer Google sign-in; must match the frontend OAuth client ID.
GOOGLE_CLIENT_ID=481498325511-77np2sun904hu5ttemeo2mtabmqan977.apps.googleusercontent.com

# Keep false for local HTTP development; set true behind HTTPS in production.
ADMIN_COOKIE_SECURE=false

# Pesapal API 3.0. Use sandbox credentials before switching to live.
PESAPAL_ENVIRONMENT=sandbox
# Enable only in a local/demo environment; this never calls a payment provider.
DEMO_CHECKOUT_ENABLED=false
# Seller approval shortcuts require both development mode and this explicit opt-in.
APP_ENV=development
SELLER_DEMO_APPROVAL_ENABLED=false
# Optional automatic approval of new sellers; keep disabled unless specifically needed.
SELLER_AUTO_APPROVE_REGISTRATIONS=false
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
# Public storefront return route and publicly reachable backend IPN endpoint.
PESAPAL_CALLBACK_URL=https://your-store.example/checkout/pesapal-return
PESAPAL_IPN_URL=https://your-api.example/api/payments/pesapal/ipn
# Register the IPN URL with `python -m app.pesapal_setup` and paste its ID here.
PESAPAL_IPN_ID=
